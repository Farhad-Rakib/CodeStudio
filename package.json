  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node ./out/test/integration/run.js",
    "test:integration:mssql": "npm run compile && node ./out/test/integration/run.js --mssql",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "~5.9.3"
  }
}
