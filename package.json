{
  "name": "codeXstudio",
  "displayName": "CodeXStudio - .NET Dev Assistant",
  "description": "A Visual Studio-inspired Solution Explorer, virtual solution folders, .NET CLI commands and themes for VS Code.",
  "version": "0.2.0",
  "preview": true,
  "publisher": "fhasancse",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#3B2585",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Farhad-Rakib/CodeXStudio.git"
  },
  "bugs": {
    "url": "https://github.com/Farhad-Rakib/CodeXStudio/issues"
  },
  "homepage": "https://github.com/Farhad-Rakib/CodeXStudio#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "keywords": [
    "dotnet",
    "csharp",
    "solution explorer",
    "sln",
    "slnx"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "onView:codestudio.solutionExplorer",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codestudio",
          "title": "CodeXStudio",
          "icon": "resources/codestudio.svg"
        }
      ]
    },
    "views": {
      "codestudio": [
        {
          "id": "codestudio.solutionExplorer",
          "name": "Solution Explorer",
          "icon": "resources/codestudio.svg",
          "when": "!config.codestudio.defaultExplorer"
        }
      ],
      "explorer": [
        {
          "id": "codestudio.solutionExplorer.explorer",
          "name": "Solution Explorer",
          "icon": "resources/codestudio.svg",
          "when": "config.codestudio.defaultExplorer && codestudio.workspaceHasSolution"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codestudio.solutionExplorer",
        "contents": "No solution is open.\n[Open Solution](command:codestudio.openSolution)\nCodeXStudio looks for .sln and .slnx files in the current workspace.",
        "when": "!codestudio.solutionLoaded"
      },
      {
        "view": "codestudio.solutionExplorer.explorer",
        "contents": "No solution is open.\n[Open Solution](command:codestudio.openSolution)\nCodeXStudio looks for .sln and .slnx files in the current workspace.",
        "when": "!codestudio.solutionLoaded"
      }
    ],
    "commands": [
      {
        "command": "codestudio.openSolution",
        "title": "Open Solution",
        "category": "CodeXStudio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codestudio.refresh",
        "title": "Refresh",
        "category": "CodeXStudio",
        "icon": "$(refresh)"
      },
      {
        "command": "codestudio.filter",
        "title": "Search Solution Explorer",
        "category": "CodeXStudio",
        "icon": "$(filter)"
      },
      {
        "command": "codestudio.clearFilter",
        "title": "Clear Search",
        "category": "CodeXStudio",
        "icon": "$(clear-all)"
      },
      {
        "command": "codestudio.buildSolution",
        "title": "Build Solution",
        "category": "CodeXStudio",
        "icon": "$(tools)"
      },
      {
        "command": "codestudio.restoreSolution",
        "title": "Restore Solution",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.selectConfiguration",
        "title": "Select Build Configuration...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.cleanSolution",
        "title": "Clean Solution",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.addExistingProject",
        "title": "Add Existing Project...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.addSolutionFolder",
        "title": "New Solution Folder",
        "category": "CodeXStudio",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "codestudio.moveProjectToSolutionFolder",
        "title": "Move to Solution Folder...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.addVirtualFolder",
        "title": "Add Virtual Folder",
        "category": "CodeXStudio",
        "icon": "$(new-folder)"
      },
      {
        "command": "codestudio.renameVirtualFolder",
        "title": "Rename",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.deleteVirtualFolder",
        "title": "Delete",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.moveProjectHere",
        "title": "Move Project Here...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.moveProjectToFolder",
        "title": "Move to Virtual Folder...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.removeFromVirtualFolder",
        "title": "Remove from Virtual Folder",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.openProjectFile",
        "title": "Open Project File",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.buildProject",
        "title": "Build Project",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.addProjectReference",
        "title": "Add Project Reference...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.manageNuGetPackages",
        "title": "Manage NuGet Packages...",
        "category": "CodeXStudio",
        "icon": "$(package)"
      },
      {
        "command": "codestudio.runTests",
        "title": "Run Tests",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.publishSqlProject",
        "title": "Publish...",
        "category": "CodeXStudio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codestudio.schemaCompareSqlProject",
        "title": "Schema Compare...",
        "category": "CodeXStudio",
        "icon": "$(diff)"
      },
      {
        "command": "codestudio.deployDacpac",
        "title": "Deploy DACPAC...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.openFile",
        "title": "Open",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.applyRecommendedSettings",
        "title": "Apply Recommended Settings...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.showSdkInfo",
        "title": "Show .NET SDK Info",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.showLog",
        "title": "Show Log",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.newProject",
        "title": "New Project...",
        "category": "CodeXStudio",
        "icon": "$(new-file)"
      },
      {
        "command": "codestudio.newItem",
        "title": "New Item...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.restoreDefaultExplorer",
        "title": "Move Solution Explorer to Its Own Sidebar",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.makeDefaultExplorer",
        "title": "Show Solution Explorer in the Explorer Sidebar",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.configureCodingStandards",
        "title": "Configure Coding Standards...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.checkCodingStandards",
        "title": "Check Coding Standards",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.fixCodingStandards",
        "title": "Fix Coding Standards...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.renameToStandard",
        "title": "Rename to Coding Standard",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.installCSharpier",
        "title": "Install CSharpier (C# Prettier)...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.setStartupProject",
        "title": "Set as Startup Project",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.clearStartupProject",
        "title": "Clear Startup Project",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.selectStartupProject",
        "title": "Configure Startup Project...",
        "category": "CodeXStudio"
      },
      {
        "command": "codestudio.runStartupProject",
        "title": "Start Without Debugging",
        "category": "CodeXStudio",
        "icon": "$(run)"
      },
      {
        "command": "codestudio.debugStartupProject",
        "title": "Start Debugging",
        "category": "CodeXStudio",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codestudio.openSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/",
          "group": "navigation@1"
        },
        {
          "command": "codestudio.filter",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "navigation@2"
        },
        {
          "command": "codestudio.clearFilter",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "codestudio.refresh",
          "when": "view =~ /^codestudio\\.solutionExplorer/",
          "group": "navigation@4"
        },
        {
          "command": "codestudio.buildSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "1_build@1"
        },
        {
          "command": "codestudio.restoreSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "1_build@2"
        },
        {
          "command": "codestudio.cleanSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "1_build@3"
        },
        {
          "command": "codestudio.addVirtualFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "2_add@1"
        },
        {
          "command": "codestudio.applyRecommendedSettings",
          "when": "view =~ /^codestudio\\.solutionExplorer/",
          "group": "3_misc@1"
        },
        {
          "command": "codestudio.showSdkInfo",
          "when": "view =~ /^codestudio\\.solutionExplorer/",
          "group": "3_misc@2"
        },
        {
          "command": "codestudio.newProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "2_add@0"
        },
        {
          "command": "codestudio.restoreDefaultExplorer",
          "when": "view == codestudio.solutionExplorer.explorer",
          "group": "9_layout@1"
        },
        {
          "command": "codestudio.makeDefaultExplorer",
          "when": "view == codestudio.solutionExplorer",
          "group": "9_layout@1"
        },
        {
          "command": "codestudio.checkCodingStandards",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "4_standards@1"
        },
        {
          "command": "codestudio.fixCodingStandards",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "4_standards@2"
        },
        {
          "command": "codestudio.configureCodingStandards",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "4_standards@3"
        },
        {
          "command": "codestudio.manageNuGetPackages",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "2_add@5"
        },
        {
          "command": "codestudio.debugStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "navigation@0"
        },
        {
          "command": "codestudio.runStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && codestudio.solutionLoaded",
          "group": "1_build@0"
        }
      ],
      "view/item/context": [
        {
          "command": "codestudio.openSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "1_solution@1"
        },
        {
          "command": "codestudio.refresh",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "1_solution@2"
        },
        {
          "command": "codestudio.buildSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "2_build@1"
        },
        {
          "command": "codestudio.restoreSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "2_build@2"
        },
        {
          "command": "codestudio.cleanSolution",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "2_build@3"
        },
        {
          "command": "codestudio.addExistingProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "3_add@1"
        },
        {
          "command": "codestudio.addSolutionFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^(solution|solutionFolder)$/",
          "group": "3_add@2"
        },
        {
          "command": "codestudio.addVirtualFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^(solution|virtualFolder)$/",
          "group": "3_add@2"
        },
        {
          "command": "codestudio.moveProjectHere",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == virtualFolder",
          "group": "3_add@3"
        },
        {
          "command": "codestudio.renameVirtualFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == virtualFolder",
          "group": "4_edit@1"
        },
        {
          "command": "codestudio.deleteVirtualFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == virtualFolder",
          "group": "4_edit@2"
        },
        {
          "command": "codestudio.openProjectFile",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project/",
          "group": "1_project@1"
        },
        {
          "command": "codestudio.buildProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project/",
          "group": "2_build@1"
        },
        {
          "command": "codestudio.runTests",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project\\.test/",
          "group": "2_build@2"
        },
        {
          "command": "codestudio.addProjectReference",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project/",
          "group": "3_add@1"
        },
        {
          "command": "codestudio.manageNuGetPackages",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project(?!\\.sql)/",
          "group": "3_add@2"
        },
        {
          "command": "codestudio.moveProjectToSolutionFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project/",
          "group": "4_layout@0"
        },
        {
          "command": "codestudio.moveProjectToFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project/",
          "group": "4_layout@1"
        },
        {
          "command": "codestudio.removeFromVirtualFolder",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project.*\\.assigned$/",
          "group": "4_layout@2"
        },
        {
          "command": "codestudio.revealInOS",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^(project|file|physicalFolder|dacpac$)/",
          "group": "9_reveal@1"
        },
        {
          "command": "codestudio.openFile",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == file",
          "group": "1_file@1"
        },
        {
          "command": "codestudio.newProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^(solution|virtualFolder)$/",
          "group": "3_add@0"
        },
        {
          "command": "codestudio.newItem",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^(project(?!\\.sql)|physicalFolder)/",
          "group": "3_add@0"
        },
        {
          "command": "codestudio.checkCodingStandards",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution && config.codestudio.codingStandards.enabled",
          "group": "2_build@4"
        },
        {
          "command": "codestudio.manageNuGetPackages",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^dependencyGroup\\.packages$/",
          "group": "inline"
        },
        {
          "command": "codestudio.setStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project(?!\\.sql)(?!.*\\.startup)/",
          "group": "0_startup@1"
        },
        {
          "command": "codestudio.clearStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project.*\\.startup/",
          "group": "0_startup@1"
        },
        {
          "command": "codestudio.debugStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project(?!\\.sql)/",
          "group": "0_startup@2"
        },
        {
          "command": "codestudio.runStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project(?!\\.sql)/",
          "group": "0_startup@3"
        },
        {
          "command": "codestudio.selectStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "1_solution@3"
        },
        {
          "command": "codestudio.selectConfiguration",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == solution",
          "group": "1_solution@4"
        },
        {
          "command": "codestudio.runStartupProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project.*\\.startup/",
          "group": "inline@1"
        },
        {
          "command": "codestudio.publishSqlProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project\\.sql/",
          "group": "2_build@3"
        },
        {
          "command": "codestudio.schemaCompareSqlProject",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem =~ /^project\\.sql/",
          "group": "2_build@4"
        },
        {
          "command": "codestudio.deployDacpac",
          "when": "view =~ /^codestudio\\.solutionExplorer/ && viewItem == dacpac",
          "group": "1_dacpac@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codestudio.renameVirtualFolder",
          "when": "false"
        },
        {
          "command": "codestudio.deleteVirtualFolder",
          "when": "false"
        },
        {
          "command": "codestudio.moveProjectHere",
          "when": "false"
        },
        {
          "command": "codestudio.removeFromVirtualFolder",
          "when": "false"
        },
        {
          "command": "codestudio.openFile",
          "when": "false"
        },
        {
          "command": "codestudio.revealInOS",
          "when": "false"
        },
        {
          "command": "codestudio.clearFilter",
          "when": "codestudio.filterActive"
        },
        {
          "command": "codestudio.restoreDefaultExplorer",
          "when": "config.codestudio.defaultExplorer"
        },
        {
          "command": "codestudio.makeDefaultExplorer",
          "when": "!config.codestudio.defaultExplorer"
        },
        {
          "command": "codestudio.renameToStandard",
          "when": "false"
        },
        {
          "command": "codestudio.clearStartupProject",
          "when": "codestudio.hasStartupProject"
        }
      ]
    },
    "themes": [
      {
        "label": "CodeXStudio Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/codestudio-dark-color-theme.json"
      },
      {
        "label": "CodeXStudio Light",
        "uiTheme": "vs",
        "path": "./themes/codestudio-light-color-theme.json"
      },
      {
        "label": "CodeXStudio Monokai",
        "uiTheme": "vs-dark",
        "path": "./themes/codestudio-monokai-color-theme.json"
      },
      {
        "label": "CodeXStudio Monokai Dimmed",
        "uiTheme": "vs-dark",
        "path": "./themes/codestudio-monokai-dimmed-color-theme.json"
      }
    ],
    "configuration": {
      "title": "CodeXStudio",
      "properties": {
        "codestudio.defaultExplorer": {
          "type": "boolean",
          "default": false,
          "order": 0,
          "markdownDescription": "Show **Solution Explorer** in VS Code's Explorer sidebar (below the built-in Files view) instead of in its own CodeXStudio sidebar in the Activity Bar.\n\nVS Code does not let extensions hide or move the Files view, so it stays visible; collapse it if you don't need it."
        },
        "codestudio.autoOpenSingleSolution": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the solution when the workspace contains exactly one .sln/.slnx file."
        },
        "codestudio.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "description": "Path to the dotnet executable. Defaults to 'dotnet' on PATH."
        },
        "codestudio.explorer.showPhysicalFiles": {
          "type": "boolean",
          "default": true,
          "description": "Show the files and folders of each project directory under the project node."
        },
        "codestudio.explorer.excludedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "bin",
            "obj",
            ".vs",
            ".git",
            "node_modules"
          ],
          "description": "Folder names hidden under project nodes."
        },
        "codestudio.codingStandards.enabled": {
          "type": "boolean",
          "default": false,
          "order": 10,
          "markdownDescription": "Enforce the coding standards below. When on, CodeXStudio reports naming violations live in C# files (with rename quick fixes) and writes the rules to the solution's `.editorconfig` so the C# language service, `dotnet format` and builds apply them too. Turning it off removes CodeXStudio's `.editorconfig` section."
        },
        "codestudio.codingStandards.severity": {
          "type": "string",
          "enum": [
            "suggestion",
            "warning",
            "error"
          ],
          "default": "warning",
          "order": 11,
          "description": "How violations are reported in the editor, .editorconfig and builds."
        },
        "codestudio.codingStandards.writeEditorConfig": {
          "type": "boolean",
          "default": true,
          "order": 12,
          "markdownDescription": "Write the rules to a managed section of `.editorconfig` beside the solution (content outside the section is preserved)."
        },
        "codestudio.codingStandards.enforceInBuild": {
          "type": "boolean",
          "default": false,
          "order": 13,
          "markdownDescription": "Pass `-p:EnforceCodeStyleInBuild=true` to CodeXStudio's Build and Run Tests commands so violations appear as build warnings/errors (with severity `error`, builds fail)."
        },
        "codestudio.codingStandards.naming.types": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "PascalCase",
          "description": "Classes, structs, records, enums and delegates.",
          "order": 20
        },
        "codestudio.codingStandards.naming.interfacePrefix": {
          "type": "boolean",
          "default": true,
          "order": 21,
          "markdownDescription": "Interfaces start with `I` (e.g. `IOrderRepository`)."
        },
        "codestudio.codingStandards.naming.typeParameterPrefix": {
          "type": "boolean",
          "default": true,
          "order": 22,
          "markdownDescription": "Generic type parameters start with `T` (e.g. `TKey`)."
        },
        "codestudio.codingStandards.naming.methods": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "PascalCase",
          "description": "Methods and local functions.",
          "order": 23
        },
        "codestudio.codingStandards.naming.asyncSuffix": {
          "type": "boolean",
          "default": true,
          "order": 24,
          "markdownDescription": "`async` methods end with `Async` (`async void` handlers and `Main` are exempt)."
        },
        "codestudio.codingStandards.naming.properties": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "PascalCase",
          "description": "Properties and events.",
          "order": 25
        },
        "codestudio.codingStandards.naming.publicFields": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "PascalCase",
          "description": "Public, internal and protected fields.",
          "order": 26
        },
        "codestudio.codingStandards.naming.privateFields": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "_camelCase",
          "description": "Private instance fields.",
          "order": 27
        },
        "codestudio.codingStandards.naming.privateStaticFields": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "s_camelCase",
          "description": "Private static fields.",
          "order": 28
        },
        "codestudio.codingStandards.naming.constants": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "PascalCase",
          "description": "Constant fields and locals.",
          "order": 29
        },
        "codestudio.codingStandards.naming.localsAndParameters": {
          "type": "string",
          "enum": [
            "PascalCase",
            "camelCase",
            "_camelCase",
            "m_camelCase",
            "s_camelCase",
            "snake_case",
            "UPPER_CASE"
          ],
          "default": "camelCase",
          "description": "Local variables and parameters.",
          "order": 30
        },
        "codestudio.codingStandards.style.var": {
          "type": "string",
          "enum": [
            "whenTypeIsApparent",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Use var only when the type is obvious (var x = new Foo())",
            "Always use var",
            "Always use explicit types"
          ],
          "default": "whenTypeIsApparent",
          "order": 40,
          "description": "Preferred use of 'var' (enforced by the C# language service and dotnet format)."
        },
        "codestudio.codingStandards.style.braces": {
          "type": "boolean",
          "default": true,
          "order": 41,
          "description": "Require braces for if/else/for/while bodies."
        },
        "codestudio.codingStandards.style.fileScopedNamespaces": {
          "type": "boolean",
          "default": true,
          "order": 42,
          "markdownDescription": "Prefer file-scoped namespaces (`namespace X;`)."
        },
        "codestudio.codingStandards.style.usingsOutsideNamespace": {
          "type": "boolean",
          "default": true,
          "order": 43,
          "description": "Place using directives outside the namespace."
        },
        "codestudio.codingStandards.style.predefinedTypes": {
          "type": "boolean",
          "default": true,
          "order": 44,
          "markdownDescription": "Use `int`/`string` instead of `Int32`/`String`."
        },
        "codestudio.formatter.enabled": {
          "type": "boolean",
          "default": true,
          "order": 50,
          "markdownDescription": "Provide a C# formatter (Format Document, format on save). If another C# formatter is installed, pick CodeXStudio with *Format Document With...* → *Configure Default Formatter*."
        },
        "codestudio.formatter.engine": {
          "type": "string",
          "enum": [
            "dotnet-format",
            "csharpier"
          ],
          "enumDescriptions": [
            "Built into the .NET SDK; follows .editorconfig (including CodeXStudio coding standards). Whitespace and indentation only.",
            "CSharpier, the opinionated \"Prettier\" for C# (install with CodeXStudio: Install CSharpier). Rewraps and restructures code consistently."
          ],
          "default": "dotnet-format",
          "order": 51,
          "description": "Formatter used for C# files."
        }
      }
    },
    "configurationDefaults": {
      "[csharp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active",
        "editor.guides.bracketPairsHorizontal": "active",
        "editor.matchBrackets": "always"
      }
    },
    "taskDefinitions": [
      {
        "type": "codestudio",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "CodeXStudio command label"
          },
          "target": {
            "type": "string",
            "description": "Solution or project file"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "codestudio.debugStartupProject",
        "key": "f5",
        "when": "focusedView =~ /^codestudio\\.solutionExplorer/ && !inDebugMode"
      },
      {
        "command": "codestudio.runStartupProject",
        "key": "ctrl+f5",
        "mac": "ctrl+f5",
        "when": "focusedView =~ /^codestudio\\.solutionExplorer/ && !inDebugMode"
      }
    ],
    "colors": [
