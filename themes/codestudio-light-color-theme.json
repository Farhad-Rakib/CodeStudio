    "codestudio.packageIcon": "#0060C0",
    "codestudio.dependencyIcon": "#616161",
    "codestudio.errorIcon": "#D42020",
    "editorWhitespace.foreground": "#9A9A9A60",
    "editorRuler.foreground": "#DDDDE3",
