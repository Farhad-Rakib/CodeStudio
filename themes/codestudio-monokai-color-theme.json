    "list.highlightForeground": "#66D9EF",
    "list.errorForeground": "#F92672",
    "list.warningForeground": "#E6DB74",
    "list.dropBackground": "#F9267240",
    "tree.indentGuidesStroke": "#414339",
    "tree.inactiveIndentGuidesStroke": "#34352D",
    "panel.background": "#272822",
    "panel.border": "#414339",
