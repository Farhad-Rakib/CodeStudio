    "tab.inactiveForeground": "#A59F85",
    "tab.border": "#34352D",
    "tab.hoverBackground": "#3E3D32",
    "tab.unfocusedActiveBorderTop": "#75715E",
    "breadcrumb.foreground": "#A59F85",
