    "terminal.foreground": "#F8F8F2",
    "terminal.selectionBackground": "#49483E",
    "terminalCursor.foreground": "#F8F8F2",
    "problemsErrorIcon.foreground": "#F92672",
    "problemsWarningIcon.foreground": "#E6DB74",
    "problemsInfoIcon.foreground": "#66D9EF",
    "statusBar.background": "#414339",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#414339",
    "statusBar.debuggingBackground": "#FD971F",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#34352D",
    "statusBarItem.remoteBackground": "#F92672",
    "statusBarItem.hoverBackground": "#FFFFFF25",
    "titleBar.activeBackground": "#1A1B17",
    "titleBar.activeForeground": "#F8F8F2",
    "titleBar.inactiveBackground": "#1A1B17",
    "titleBar.inactiveForeground": "#A59F85",
