    "terminal.ansiBrightBlue": "#819AFF",
    "terminal.ansiMagenta": "#8C6BC8",
    "terminal.ansiBrightMagenta": "#AE81FF",
    "terminal.ansiCyan": "#56ADBC",
    "terminal.ansiBrightCyan": "#66D9EF",
    "terminal.ansiWhite": "#E3E3DD",
    "terminal.ansiBrightWhite": "#F8F8F2"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#75715E"
      }
    },
    {
      "name": "XML doc comments",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#75715E"
      }
    },
    {
      "name": "XML doc tags",
      "scope": [
        "comment.documentation.name",
        "comment.documentation.attribute.name",
        "comment.documentation.delimiter"
      ],
      "settings": {
        "foreground": "#75715E"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.other.var",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.context"
      ],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.cast",
        "keyword.operator.logical.pattern"
      ],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#E6DB74"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#AE81FF"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#E6DB74"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#AE81FF"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "name": "Structs",
      "scope": [
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "name": "Enums",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#FD971F"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.type.namespace",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#A6E22E"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "entity.name.variable.property"
      ],
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Fields",
      "scope": [
        "variable.other.object.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "entity.name.variable.enum-member",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#AE81FF"
      }
    },
    {
      "name": "Locals",
      "scope": [
        "variable",
        "entity.name.variable.local"
      ],
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#FD971F"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.preprocessor",
        "entity.name.variable.preprocessor.symbol"
      ],
      "settings": {
        "foreground": "#75715E"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.name.type.attribute",
        "support.type.attribute"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "name": "XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F92672"
      }
    },
    {
      "name": "XML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A6E22E"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F92672",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F44747"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#F8F8F2",
    "class": "#66D9EF",
    "class.static": "#66D9EF",
    "record": "#66D9EF",
    "struct": "#66D9EF",
    "recordStruct": "#66D9EF",
    "interface": "#66D9EF",
    "enum": "#66D9EF",
    "enumMember": "#AE81FF",
    "typeParameter": "#FD971F",
    "delegate": "#66D9EF",
    "type": "#66D9EF",
    "method": "#A6E22E",
    "function": "#A6E22E",
    "extensionMethod": "#A6E22E",
    "event": "#F8F8F2",
    "property": "#F8F8F2",
    "field": "#F8F8F2",
    "constant": "#F8F8F2",
    "variable": "#F8F8F2",
    "local": "#F8F8F2",
    "parameter": "#FD971F",
    "label": "#A59F85",
    "keyword": "#F92672",
    "controlKeyword": "#F92672",
    "operatorOverloaded": "#A6E22E",
    "string": "#E6DB74",
    "stringEscapeCharacter": "#AE81FF",
    "number": "#AE81FF",
    "comment": "#75715E",
    "regexp": "#E6DB74",
    "preprocessorKeyword": "#75715E",
    "excludedCode": "#75715E",
    "xmlDocCommentName": "#75715E",
    "xmlDocCommentText": "#75715E",
    "xmlDocCommentDelimiter": "#75715E",
    "xmlDocCommentAttributeName": "#75715E",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
