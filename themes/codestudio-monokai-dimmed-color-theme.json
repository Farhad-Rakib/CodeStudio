    "peekViewResult.background": "#272727",
    "peekViewTitle.background": "#272727",
    "editorInlayHint.foreground": "#9A9B99",
    "editorInlayHint.background": "#30303080",
    "editorStickyScroll.background": "#1E1E1E",
